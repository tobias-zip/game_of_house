{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(pnpm install)",
            "Bash(pnpm lint:*)",
            "Bash(pnpm format:*)",
            "Bash(pnpm typecheck:*)",
            "Bash(pnpm test:*)",
            "Bash(pnpm build:*)",
            "Bash(pnpm check:*)",
            "Bash(pnpm exec biome:*)",
            "Bash(pnpm exec tsc:*)",
            "Bash(pnpm exec vitest:*)"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|MultiEdit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\""
                    }
                ]
            }
        ]
    }
}
